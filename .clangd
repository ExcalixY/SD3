CompileFlags:
  # GCC-only flags from the CMake compile database that clang doesn't understand
  # Leftovers from GCC module scanning, in case an old compile database is loaded
  Remove:
    - -fmodules-ts
    - -fmodule-mapper=*
    - -fdeps-format=*
  Add:
    - -Wall
    - -Wextra
    - -Wno-unused-parameter

Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes

Documentation:
  CommentFormat: Doxygen
